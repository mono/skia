#!/usr/bin/env python3
import os, shutil, stat

os.chdir(os.path.join(os.path.dirname(__file__), os.pardir))

gn_filename = 'gn'
gn_path = os.path.join('bin', gn_filename)

if os.path.exists(gn_path):
    print("fetch-gn: gn already exists, skipping download")
    # Also copy to third_party/gn/
    depot_tools_gn_dir = os.path.join('third_party', 'gn')
    os.makedirs(depot_tools_gn_dir, exist_ok=True)
    dst = os.path.join(depot_tools_gn_dir, gn_filename)
    if not os.path.exists(dst):
        shutil.copy(gn_path, dst)
else:
    print("fetch-gn: ERROR - gn not found and cannot download in this environment")
    exit(1)
