load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")
load(
    "//bazel:skia_rules.bzl",
    "RUST_COMPATIBILITY",
    "skia_cc_library",
    "skia_filegroup",
)

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

skia_filegroup(
    name = "rs_srcs",
    srcs = ["io_traits_ffi.rs"],
    visibility = ["//:__subpackages__"],
)

skia_filegroup(
    name = "cxx_bridge_srcs",
    srcs = ["io_traits_ffi.rs"],
    visibility = ["//:__subpackages__"],
)

skia_filegroup(
    name = "ffi_hdrs",
    srcs = [
        "SkStreamAdapter.h",
        "SpanUtils.h",
    ],
    visibility = ["//:__subpackages__"],
)

# C++ implementation files for FFI utilities
skia_filegroup(
    name = "ffi_cpp",
    srcs = ["SkStreamAdapter.cpp"],
    visibility = ["//:__subpackages__"],
)

# Shared FFI utilities for Rust codec integrations.
skia_cc_library(
    name = "ffi_utils",
    srcs = [":ffi_cpp"],
    hdrs = [":ffi_hdrs"],
    compatible_with = RUST_COMPATIBILITY,
    features = ["layering_check"],
    visibility = [
        "//experimental/rust_ico/decoder/impl:__pkg__",
        "//experimental/rust_ico/ffi:__pkg__",
        "//experimental/rust_jpeg/decoder/impl:__pkg__",
        "//experimental/rust_jpeg/ffi:__pkg__",
        "//experimental/rust_raw/decoder:__pkg__",
        "//experimental/rust_raw/ffi:__pkg__",
        "//rust/bmp:__pkg__",
        "//rust/icc:__pkg__",
        "//rust/png:__pkg__",
        "//src/codec:__pkg__",
        "//src/encode:__pkg__",
    ],
    deps = [
        "//:core",
        "//src/core:core_priv",
        "@crates//:cxx_cc",
    ],
)

rust_cxx_bridge(
    name = "cxx_bridge",
    src = ":rs_srcs",
    visibility = [
        "//experimental/rust_ico/ffi:__pkg__",
        "//experimental/rust_jpeg/ffi:__pkg__",
        "//experimental/rust_raw/ffi:__pkg__",
        "//rust/bmp:__pkg__",
        "//rust/icc:__pkg__",
        "//rust/png:__pkg__",
    ],
    deps = [":ffi_utils"],
)

rust_library(
    name = "skia_rust_common",
    srcs = ["io_traits_ffi.rs"],
    crate_root = "io_traits_ffi.rs",
    rustc_flags = [
        "-Dwarnings",
        "--cfg=cxxbridge1",
    ],
    visibility = [
        "//experimental/rust_ico/ffi:__pkg__",
        "//experimental/rust_jpeg/ffi:__pkg__",
        "//experimental/rust_raw/ffi:__pkg__",
        "//rust/bmp:__pkg__",
        "//rust/icc:__pkg__",
        "//rust/png:__pkg__",
    ],
    deps = [
        ":cxx_bridge",
        ":ffi_utils",
        "@crates//:cxx",
    ],
)

# GN provides the C++ bridge and SkStreamAdapter; its Rust archive must not
# bring in a second, unsanitized copy of Skia's native core.
rust_library(
    name = "skia_rust_common_gn",
    crate_name = "skia_rust_common",
    srcs = ["io_traits_ffi.rs"],
    crate_root = "io_traits_ffi.rs",
    rustc_flags = [
        "-Dwarnings",
        "--cfg=cxxbridge1",
    ],
    visibility = ["//experimental/rust_raw/ffi:__pkg__"],
    deps = ["@@rules_rust++crate+crates__cxx-1.0.168//:cxx_rust_gn"],
)
