+	uint64 right64	= left64 + (uint64) fTileWidth;
 	
-	r.l = colIndex * fTileWidth;
-	r.r = r.l	   + fTileWidth;
-	
-	// If this IFD is using strips rather than tiles, the last strip
-	// is trimmed so it does not extend beyond the end of the image.
+	if (fUsesStrips && bottom64 > (uint64) fImageLength)
+		{
+		bottom64 = fImageLength;
+		}
 	
-	if (fUsesStrips)
+	int32 top	 = 0;
+	int32 left	 = 0;
+	int32 bottom = 0;
+	int32 right	 = 0;
+	
+	if (top64	 > (uint64) 0x7FFFFFFF ||
+		left64	 > (uint64) 0x7FFFFFFF ||
+		bottom64 > (uint64) 0x7FFFFFFF ||
+		right64	 > (uint64) 0x7FFFFFFF ||
+		bottom64 < top64 ||
+		right64	 < left64 ||
+		!ConvertUint32ToInt32 ((uint32) top64,	  &top) ||
+		!ConvertUint32ToInt32 ((uint32) left64,	  &left) ||
+		!ConvertUint32ToInt32 ((uint32) bottom64, &bottom) ||
+		!ConvertUint32ToInt32 ((uint32) right64,  &right))
 		{
 		
-		r.b = Min_uint32 (r.b, fImageLength);
+		ThrowBadFormat ();
 		
 		}
-		
-	return r;
+	
+	return dng_rect (top, left, bottom, right);
 	
 	}
 			
