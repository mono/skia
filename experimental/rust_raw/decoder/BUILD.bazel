load("//bazel:skia_rules.bzl", "skia_cc_library", "skia_filegroup")

skia_filegroup(
    name = "hdrs",
    srcs = ["SkRawRustDecoder.h"],
)

skia_filegroup(
    name = "srcs",
    srcs = ["SkRawRustDecoder.cpp"],
)

skia_cc_library(
    name = "rust_raw_decoder",
    srcs = [":srcs"],
    hdrs = [":hdrs"],
    features = ["layering_check"],
    visibility = ["//:__pkg__", "//tests:__pkg__"],
    deps = [
        "//:core",
        "//experimental/rust_raw/ffi:cxx_bridge",
        "//experimental/rust_raw/ffi:ffi_rs",
        "//modules/skcms",
        "//rust/common:ffi_utils",
        "//src/codec:codec_support_priv",
        "//src/core:core_priv",
        "@crates//:cxx_cc",
        "@skia_user_config//:user_config",
    ],
)
